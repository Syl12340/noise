/* pages/index/index.wxss */
page {
  background: #F4F5F7; /* 统一的高级极浅灰底色 */
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

.page {
  padding: 40rpx 32rpx;
}

/* 顶部插画：增加一点下边距，使其不那么拥挤 */
.hero {
  width: 100%;
  height: 380rpx;
  margin: 0 auto 50rpx;
  display: block;
}

.grid {
  display: flex;
  flex-direction: column;
  gap: 28rpx; /* 卡片之间的间距 */
}

/* 模块化卡片设计 */
.card {
  display: flex;
  align-items: center;
  padding: 40rpx 36rpx;
  background: #FFFFFF;
  border-radius: 32rpx; /* 现代大圆角 */
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03); /* 极度柔和的阴影 */
  transition: all 0.25s cubic-bezier(0.25, 0.8, 0.25, 1); /* 丝滑过渡 */
}

/* 🌟 高级按压反馈：不再变纯蓝，而是轻微下压变灰，更有物理按键质感 */
.card--pressed {
  background: #FAFAFA !important;
  transform: scale(0.97);
  box-shadow: 0 2rpx 10rpx rgba(164, 31, 53, 0.05);
}

/* 图标容器：可以给图标加个极浅的红色背景底衬，强化品牌感 */
.card__icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 32rpx;
  flex-shrink: 0;
}

.card__body {
  flex: 1;
}

.card__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
  margin-bottom: 8rpx;
}

.card__desc {
  font-size: 26rpx;
  color: #888888;
  display: block;
}

/* 底部小贴士 */
.tips {
  margin-top: 80rpx;
  text-align: center;
  font-size: 24rpx;
  color: #A0A0A0;
  line-height: 1.6;
}