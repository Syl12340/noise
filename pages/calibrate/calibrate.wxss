/* pages/calibrate/calibrate.wxss */
page {
  background: #F4F5F7;
  font-family: -apple-system, sans-serif;
}

.page-container {
  padding: 30rpx 30rpx 220rpx; /* 为底部悬浮按钮留出空间 */
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 统一的白色卡片底座 */
.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.03);
  box-sizing: border-box;
}

/* 顶部信息卡片 */
.info-card { padding: 40rpx; }
.info-title { font-size: 32rpx; font-weight: 700; color: #111; display: block; margin-bottom: 12rpx; }
.info-desc { font-size: 24rpx; color: #888; line-height: 1.5; display: block; }

/* 示波器面板 */
.chart-card { padding: 30rpx 0 10rpx 0; overflow: hidden; }
.data-row {
  display: flex; justify-content: space-around;
  margin-bottom: 20rpx; padding: 0 40rpx;
}
.data-item { display: flex; flex-direction: column; align-items: center; }
.d-label { font-size: 22rpx; color: #999; margin-bottom: 8rpx;}
.d-val { font-size: 44rpx; font-weight: 700; color: #333; font-variant-numeric: tabular-nums; }
.text-red { color: #A41F35; }

/* --- 优化：Canvas 居中容器 --- */
.canvas-container {
  width: 100%;
  height: 800rpx;
  display: flex;         
  justify-content: center; 
  align-items: center;     
  background: #fff;
  position: relative;
}
.canvas-layer {
  width: 620rpx; /* 与 JS 中的 globalSize 对应 */
  height: 600rpx;
}

/* 校准操作区 */
.action-card { padding: 40rpx; }
.section-title { font-size: 26rpx; color: #999; font-weight: 600; margin-bottom: 24rpx; display: block; }

.btn-group { display: flex; flex-direction: column; gap: 20rpx; }
.calib-btn {
  background: #F4F5F7;
  color: #333;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: 1rpx solid #EAEAEA;
  transition: all 0.2s;
}
.calib-btn:active { background: rgba(164, 31, 53, 0.1); color: #A41F35; border-color: rgba(164, 31, 53, 0.3); }

/* 结果框 */
.result-box {
  margin-top: 30rpx; padding: 24rpx;
  background: rgba(164, 31, 53, 0.04);
  border-radius: 16rpx; border: 1rpx dashed rgba(164, 31, 53, 0.2);
}
.result-item { font-size: 26rpx; color: #555; margin-bottom: 8rpx; }
.highlight { font-size: 32rpx; font-weight: 800; color: #A41F35; }

/* --- 优化：底部固定操作栏 --- */
.action-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20px);
  padding: 30rpx 40rpx calc(30rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 -10rpx 40rpx rgba(0,0,0,0.05);
  z-index: 100;
}
.btn-main {
  border-radius: 28rpx;
  padding: 30rpx 0;
  font-size: 30rpx;
  font-weight: bold;
  margin: 0;
  display: flex;
  justify-content: center;
  align-items: center;
}
/* 结束按钮占 1 份，保存按钮占 1.5 份，凸显保存操作 */
.btn-stop { flex: 1; background: #FFFFFF; color: #A41F35; border: 2rpx solid #A41F35; }
.btn-save { flex: 1.5; background: #A41F35; color: #fff; box-shadow: 0 10rpx 20rpx rgba(164, 31, 53, 0.2); }
.btn-hover { transform: scale(0.97); opacity: 0.9; }