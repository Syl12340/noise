<!-- pages/phonetic/phonetic.wxml -->
<view class="page">

  <view class="card settings-card" wx:if="{{state === 'idle'}}">
    <text class="section-title">录音与分析参数</text>
    <picker range="{{taskOptions}}" value="{{taskIndex}}" data-key="taskIndex" bindchange="setAnalysisOption"><view class="option-row"><text class="option-label">录音任务</text><text class="option-value">{{taskOptions[taskIndex]}} ›</text></view></picker>
    <picker range="{{orderOptions}}" value="{{orderIndex}}" data-key="orderIndex" bindchange="setAnalysisOption"><view class="option-row"><text class="option-label">LPC 阶数</text><text class="option-value">{{orderOptions[orderIndex]}} ›</text></view></picker>
    <picker range="{{maxFormantOptions}}" value="{{maxFormantIndex}}" data-key="maxFormantIndex" bindchange="setAnalysisOption"><view class="option-row"><text class="option-label">共振峰上限</text><text class="option-value">{{maxFormantOptions[maxFormantIndex]}} Hz ›</text></view></picker>
    <picker range="{{windowOptions}}" value="{{windowIndex}}" data-key="windowIndex" bindchange="setAnalysisOption"><view class="option-row"><text class="option-label">共振峰窗长</text><text class="option-value">{{windowOptions[windowIndex]}} ms ›</text></view></picker>
    <text class="body-note">比较时请使用相同参数。共振峰上限可按说话人选择 4–8 kHz；更高上限不保证更准确。</text>
  </view>
  <!-- 语谱图显示区 -->
  <view class="card chart-card">
    <view class="chart-header">
      <text class="chart-title">
        {{state === 'result' ? '语音学分析结果' : '语音学分析'}}
      </text>
      <text class="chart-time" wx:if="{{state === 'result' && selectedTime !== null && viewMode === 'spectrogram'}}">
        t = {{selectedTime}}s
      </text>
    </view>

    <!-- 视图切换 tabs -->
    <view class="view-tabs" wx:if="{{state === 'result'}}">
      <view class="tab-item {{viewMode === 'spectrogram' ? 'tab-active' : ''}}" bindtap="switchView" data-mode="spectrogram">语谱图</view>
      <view class="tab-item {{viewMode === 'ltas' ? 'tab-active' : ''}}" bindtap="switchView" data-mode="ltas">LTAS</view>
      <view class="tab-item {{viewMode === 'vowel' ? 'tab-active' : ''}}" bindtap="switchView" data-mode="vowel">元音空间</view>
    </view>

    <!-- 语谱图 canvas -->
    <scroll-view scroll-x="{{zoom > 1}}" wx:if="{{viewMode === 'spectrogram'}}">
    <view class="canvas-container" style="width: {{chartWidth}};">
      <canvas id="canvas-spectrogram" type="2d" class="canvas-layer" />
      <canvas id="canvas-overlay" type="2d" class="canvas-overlay"
              bindtouchstart="onOverlayTouchStart"
              bindtouchmove="onOverlayTouchMove"
              bindtouchend="onOverlayTouchEnd" />
    </view>

    </scroll-view>
    <view class="zoom-tools" wx:if="{{state === 'result' && viewMode === 'spectrogram'}}">
      <view class="zoom-buttons">
        <button class="zoom-button {{zoom === 1 ? 'zoom-active' : ''}}" size="mini" bindtap="changeZoom" data-zoom="1">1×</button>
        <button class="zoom-button {{zoom === 2 ? 'zoom-active' : ''}}" size="mini" bindtap="changeZoom" data-zoom="2">2×</button>
        <button class="zoom-button {{zoom === 4 ? 'zoom-active' : ''}}" size="mini" bindtap="changeZoom" data-zoom="4">4×</button>
      </view>
      <text class="body-note">放大后可横向滚动，也可在下方输入选区起止时间。</text>
    </view>
    <!-- 语谱图图例：放到画布下方，避免覆盖绘制区域 -->
    <view class="legend" wx:if="{{state === 'result' && viewMode === 'spectrogram'}}">
      <view class="legend-item">
        <view class="legend-dot" style="background:#40B4E5"></view>
        <text class="legend-label">F0 基频</text>
      </view>
      <view class="legend-item">
        <view class="legend-dot" style="background:#A41F35"></view>
        <text class="legend-label">F1 第一共振峰候选</text>
      </view>
      <view class="legend-item">
        <view class="legend-dot" style="background:#FF8800"></view>
        <text class="legend-label">F2 第二共振峰候选</text>
      </view>
      <view class="legend-item">
        <view class="legend-dot" style="background:#FFB819"></view>
        <text class="legend-label">F3 第三共振峰候选</text>
      </view>
      <view class="legend-item">
        <view class="legend-dot" style="background:#FFD700"></view>
        <text class="legend-label">声强</text>
      </view>
    </view>

    <!-- LTAS canvas -->
    <view class="canvas-container" wx:if="{{viewMode === 'ltas'}}">
      <canvas id="canvas-ltas" type="2d" class="canvas-layer" />
    </view>

    <!-- 元音空间图 canvas -->
    <view class="canvas-container" wx:if="{{viewMode === 'vowel'}}">
      <canvas id="canvas-vowel" type="2d" class="canvas-layer" />
    </view>

  </view>

  <view class="card note-card" wx:if="{{state === 'result' && pointNote}}"><text class="body-note">{{pointNote}}</text></view>
  <view class="card note-card" wx:if="{{state === 'result' && captureNote}}"><text class="section-title">录音说明</text><text class="body-note">{{captureNote}}</text></view>
  <view class="card note-card" wx:if="{{state === 'result'}}">
    <text class="section-title">探索性分析</text>
    <text class="body-note">共振峰为模型候选，不能直接用作诊断。~ 数值及语谱图、元音图空心点表示谐波稀疏或参数不稳定、尚未验证的候选，不计入已接受帧统计；比较时请同时核对覆盖率。</text>
  </view>
  <!-- 数值卡片（结果态） -->
  <view class="stats-row" wx:if="{{state === 'result'}}">
    <view class="card stats-card">
      <text class="stats-label">F0 基频</text>
      <view class="stats-value">
        <text class="val">{{f0}}</text>
        <text class="unit">Hz</text>
      </view>
    </view>
    <view class="card stats-card">
      <text class="stats-label">F1 第一共振峰候选</text>
      <view class="stats-value">
        <text class="val">{{f1}}</text>
        <text class="unit">Hz</text>
      </view>
    </view>
  </view>

  <view class="stats-row" wx:if="{{state === 'result'}}">
    <view class="card stats-card">
      <text class="stats-label">F2 第二共振峰候选</text>
      <view class="stats-value">
        <text class="val">{{f2}}</text>
        <text class="unit">Hz</text>
      </view>
    </view>
    <view class="card stats-card">
      <text class="stats-label">F3 第三共振峰候选</text>
      <view class="stats-value">
        <text class="val">{{f3}}</text>
        <text class="unit">Hz</text>
      </view>
    </view>
  </view>

  <view class="stats-row" wx:if="{{state === 'result'}}">
    <view class="card stats-card">
      <text class="stats-label">限带 HNR（全段，低通 5.5 kHz）</text>
      <view class="stats-value">
        <text class="val">{{hnr}}</text>
        <text class="unit">dB</text>
      </view>
    </view>
    <view class="card stats-card">
      <text class="stats-label">帧间周期变化率（全段）</text>
      <view class="stats-value">
        <text class="val">{{jitter}}</text>
        <text class="unit">%</text>
      </view>
    </view>
  </view>

  <view class="stats-row" wx:if="{{state === 'result'}}">
    <view class="card stats-card">
      <text class="stats-label">短时声强</text>
      <view class="stats-value">
        <text class="val">{{intensity}}</text>
        <text class="unit">dBFS</text>
      </view>
    </view>
  </view>

  <view class="card note-card" wx:if="{{state === 'result'}}"><text class="section-title">分析说明</text><text class="body-note">{{analysisNote}}</text></view>

  <view class="card note-card" wx:if="{{state === 'result'}}">
    <text class="section-title">分析选区（秒，按完整窗统计）</text>
    <view class="selection-inputs">
      <input class="time-input" type="digit" value="{{selectionInputStart}}" data-key="selectionInputStart" bindinput="setSelectionInput" aria-label="选区开始秒数" />
      <text class="range-separator">至</text>
      <input class="time-input" type="digit" value="{{selectionInputEnd}}" data-key="selectionInputEnd" bindinput="setSelectionInput" aria-label="选区结束秒数" />
    </view>
    <button class="selection-apply" bindtap="applySelection">应用选区</button>
    <button class="selection-apply" bindtap="reanalyzeSelection" loading="{{selectionBusy}}" disabled="{{selectionBusy}}">独立重分析选区</button>
    <button class="selection-apply" bindtap="reanalyzeSelection" data-sensitivity="{{true}}" disabled="{{selectionBusy}}">独立分析并复核参数敏感性</button>
    <text class="body-note" wx:if="{{selectionStage}}">{{selectionStage}}</text>
    <text class="body-note" wx:if="{{selectionCoverage}}">{{selectionCoverage}}</text>
  </view>
  <!-- 选区统计 -->
  <view class="card selection-card" wx:if="{{state === 'result' && selectionStart !== null}}">
    <view class="selection-header">
      <text class="selection-title">选区统计</text>
      <text class="selection-range">{{selectionStart}}s — {{selectionEnd}}s</text>
    </view>
    <view class="stats-row">
      <view class="card stats-card inner-card">
        <text class="stats-label">时长</text>
        <view class="stats-value">
          <text class="val">{{selDuration}}</text>
          <text class="unit">s</text>
        </view>
      </view>
      <view class="card stats-card inner-card">
        <text class="stats-label">平均 F0（仅有声帧）</text>
        <view class="stats-value">
          <text class="val">{{selMeanF0}}</text>
          <text class="unit">Hz</text>
        </view>
      </view>
      <view class="card stats-card inner-card">
        <text class="stats-label">最大声强</text>
        <view class="stats-value">
          <text class="val">{{selMaxIntensity}}</text>
          <text class="unit">dBFS</text>
        </view>
      </view>
      <view class="card stats-card inner-card">
        <text class="stats-label">平均 HNR（有效有声帧）</text>
        <view class="stats-value">
          <text class="val">{{selMeanHnr}}</text>
          <text class="unit">dB</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{state === 'result' && selectionStart !== null && selHnrNote}}"><text class="body-note">{{selHnrNote}}</text></view>

  <!-- 录音中 -->
  <view class="card status-card" wx:if="{{state === 'recording'}}">
    <view class="recording-indicator">
      <view class="rec-dot"></view>
      <text class="rec-label">录音中</text>
    </view>
    <text class="rec-time">{{recordTime}}s / 5s</text>
    <text class="rec-hint">{{taskIndex === 0 ? '请以舒适音高和响度持续发同一个元音' : '请朗读固定句子；全段周期变化包含语调'}}</text>
  </view>

  <view class="card status-card" wx:if="{{state === 'starting'}}"><text class="rec-label">正在等待录音器启动…</text></view>
  <view class="card status-card" wx:if="{{state === 'stopping'}}"><text class="rec-label">正在收齐最后一段音频…</text></view>
  <!-- 分析中 -->
  <view class="card status-card" wx:if="{{state === 'analyzing'}}">
    <text class="analyzing-stage">{{progressStage}}</text>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progress}}%"></view>
    </view>
    <text class="analyzing-percent">{{progress}}%</text>
  </view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <button class="btn-main btn-start" wx:if="{{state === 'idle'}}"
            bindtap="startRecording" hover-class="btn-hover">开始录音</button>
    <button class="btn-main btn-stop" wx:if="{{state === 'recording' || state === 'starting'}}"
            bindtap="stopRecording" hover-class="btn-hover">停止录音</button>
    <button class="btn-main btn-stop" wx:if="{{state === 'analyzing'}}" bindtap="resetToIdle">取消分析</button>
    <button class="btn-main btn-retry" wx:if="{{state === 'result'}}"
            bindtap="resetToIdle" hover-class="btn-hover">重新录音</button>
  </view>

  <!-- 说明文字 -->
  <view class="tips" wx:if="{{state === 'idle'}}">
    <text>录制 3-5 秒语音，系统将自动分析语谱图、基频和共振峰</text>
  </view>
</view>
