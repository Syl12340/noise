<!-- pages/advanced-calibrate/advanced-calibrate.wxml -->
<view class="page-container">
  
  <!-- 顶部状态面板 -->
  <view class="status-panel">
    <text class="status-label">当前设备偏移量 (Offset)</text>
    <view class="status-value-wrapper">
      <text class="status-value">{{currentOffset > 0 ? '+' : ''}}{{currentOffset}}</text>
      <text class="status-unit">dB</text>
    </view>
  </view>

  <!-- 快捷校准组 -->
  <view class="status-panel calibration-summary">
    <text class="calibration-badge">{{calibrationLabel}}</text>
    <view class="calibration-dates"><text>参数记录 {{calibrationDate}}</text><text>建议复核 {{validUntil}}</text></view>
    <text class="calibration-note">没有校准条件也可继续检测和保存估算记录。实验室预校准保留来源标记；更换输入设备后可重新校准。</text>
    <view class="calibration-actions">
      <button class="calibration-action" bindtap="invalidateChangedInput">更新采集条件</button>
      <button class="calibration-action action-secondary" bindtap="exportCalibration">复制校准备份</button>
    </view>
  </view>
  <view class="group-title">快捷校准</view>
  <view class="action-group">
    <view class="action-cell" hover-class="cell-hover" bindtap="applyPresetCalibration">
      <view class="cell-left">
        <image class="cell-icon" src="../../images/apply.svg" mode="aspectFit" />
        <text class="cell-text">匹配实验室预校准</text>
      </view>
      <text class="cell-arrow">›</text>
    </view>
    <view class="action-cell" hover-class="cell-hover" bindtap="importCalibration">
      <view class="cell-left">
        <image class="cell-icon" src="../../images/download.svg" mode="aspectFit" />
        <text class="cell-text">从 剪贴板 导入参数</text>
      </view>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <!-- 专业工具组 -->
  <view class="group-title">专业工具</view>
  <view class="action-group">
    <view class="action-cell" hover-class="cell-hover" bindtap="goToAdvancedCalibration">
      <view class="cell-left">
        <image class="cell-icon" src="../../images/calibrate.svg" mode="aspectFit" />
        <text class="cell-text">执行声学标定 (1kHz, 80 dB SPL 纯音)</text>
      </view>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <!-- 设备与支持组 -->
  <view class="group-title">实验室多频、多声级复核（可选）</view>
  <view class="status-panel calibration-summary">
    <text class="calibration-note">导入外部实验室测点。points 包含 frequencyHz、referenceLevelDb、measuredDbfs，可附 uncertaintyDb。可比较读数需注明 captureProfile、inputChain、参考/测量计权 referenceWeighting/measuredWeighting（A/C/Z）和共同积分时长 integrationSeconds；时长不同时分别注明 referenceIntegrationSeconds/measuredIntegrationSeconds。条件未说明或不一致时保留原始读数差。只记录实际测点，不推断全频带性能或自动补偿；没有实验室条件可继续检测和保存。</text>
    <textarea class="laboratory-input" value="{{laboratoryInput}}" bindinput="setLaboratoryInput" maxlength="50000" placeholder="粘贴实验室复核 JSON 数据" />
    <view class="calibration-actions"><button class="calibration-action" bindtap="recordLaboratoryVerification">记录外部复核证据</button></view>
    <text class="calibration-note" wx:if="{{laboratorySummary}}">{{laboratorySummary}}</text>
  </view>
  <view class="group-title">设备与支持</view>
  <view class="action-group">
    <view class="action-cell" hover-class="cell-hover" bindtap="fetchDeviceInfo">
      <view class="cell-left">
        <image class="cell-icon" src="../../images/info.svg" mode="aspectFit" />
        <text class="cell-text">获取本机设备信息</text>
      </view>
      <text class="cell-arrow">›</text>
    </view>
    <!-- 
    <view class="action-cell" hover-class="cell-hover" bindtap="getNoiCali">
      <view class="cell-left">
        <image class="cell-icon" src="../../images/download.svg" mode="aspectFit" />
        <text class="cell-text">获取 NoiCali for Android</text>
      </view>
      <text class="cell-arrow">›</text>
    </view>
    -->
  </view>
</view>
