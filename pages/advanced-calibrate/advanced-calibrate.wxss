/* pages/advanced-calibrate/advanced-calibrate.wxss */
page { background: #F4F5F7; font-family: -apple-system, sans-serif; }
.page-container { padding: 40rpx 32rpx 60rpx; }

/* 顶部状态面板 */
.status-panel {
  background: #FFFFFF; border-radius: 32rpx;
  padding: 40rpx; margin-bottom: 50rpx;
  display: flex; flex-direction: column; align-items: center;
  box-shadow: 0 10rpx 30rpx rgba(164, 31, 53, 0.05);
  border: 2rpx solid rgba(164, 31, 53, 0.1);
}
.status-label { font-size: 26rpx; color: #888; margin-bottom: 12rpx; text-transform: uppercase; }
.status-value-wrapper { display: flex; align-items: baseline; color: #A41F35; }
.status-value { font-size: 72rpx; font-weight: 800; font-family: 'DIN Alternate', sans-serif; }
.status-unit { font-size: 32rpx; font-weight: 600; margin-left: 8rpx; }

/* 列表分组 */
.calibration-summary { align-items: stretch; padding: 30rpx; margin-bottom: 36rpx; }
.calibration-badge { align-self: flex-start; padding: 8rpx 18rpx; background: rgba(var(--ecnu-primary-rgb), var(--alpha-10)); color: var(--ecnu-primary); border-radius: 14rpx; font-size: 24rpx; line-height: 1.6; }
.calibration-dates { display: flex; flex-wrap: wrap; gap: 12rpx 24rpx; margin: 18rpx 0; font-size: 22rpx; color: #888; }
.calibration-note { display: block; font-size: 24rpx; color: #888; line-height: 1.75; overflow-wrap: break-word; word-break: break-all; }
.calibration-actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; }
.calibration-action { flex: 1; min-width: 200rpx; margin: 0; padding: 18rpx 12rpx; border-radius: 16rpx; font-size: 24rpx; line-height: 1.5; background: rgba(var(--ecnu-primary-rgb), var(--alpha-10)); color: var(--ecnu-primary); }
.calibration-action::after { border: none; }
.action-secondary { background: #F4F5F7; color: var(--ecnu-dark-gray); }
.laboratory-input { box-sizing: border-box; width: 100%; min-height: 220rpx; margin-top: 24rpx; padding: 20rpx; border-radius: 16rpx; background: #F4F5F7; color: #333; font-size: 24rpx; line-height: 1.6; }
.cell-left { min-width: 0; }
.cell-text { line-height: 1.6; }

.group-title { font-size: 26rpx; font-weight: 600; color: #888; margin: 0 0 16rpx 16rpx; }
.action-group {
  background: #FFFFFF; border-radius: 24rpx;
  overflow: hidden; margin-bottom: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

.action-cell {
  display: flex; justify-content: space-between; align-items: center;
  padding: 36rpx 32rpx; border-bottom: 1rpx solid #F0F0F0;
  transition: background 0.2s;
}
.action-cell:last-child { border-bottom: none; }
.cell-hover { background: #F9F9F9; }

.cell-left { display: flex; align-items: center; }
.cell-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.cell-text { font-size: 30rpx; font-weight: 500; color: #333; }
.cell-arrow { font-size: 36rpx; color: #CCC; font-weight: 300; }
