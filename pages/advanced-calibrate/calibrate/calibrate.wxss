/* pages/advanced-calibrate/calibrate/calibrate.wxss */
page { background: #F4F5F7; font-family: -apple-system, sans-serif; }
.container { padding: 36rpx 30rpx calc(40rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 28rpx; }
.status-box, .data-panel { background: var(--ecnu-bg-white); border-radius: 32rpx; padding: 32rpx; box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.03); }
.status-box { text-align: center; }
.panel-caption { display: block; color: #999; font-size: 24rpx; margin-bottom: 24rpx; }
.calibration-status { display: block; font-size: 30rpx; font-weight: 600; line-height: 1.8; white-space: pre-line; }
.data-row { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 12rpx; padding: 18rpx 0; }
.data-label { font-size: 25rpx; color: #888; }
.data-value { font-size: 32rpx; font-weight: 600; color: var(--ecnu-dark-gray); font-variant-numeric: tabular-nums; }
.data-unit { font-size: 21rpx; font-weight: 400; color: #999; }
.btn[disabled] { color: #999; background: #E9EAEC; box-shadow: none; }
.reference-input { flex: 1; min-width: 180rpx; max-width: 100%; padding: 12rpx 16rpx; border-radius: 12rpx; background: #F4F5F7; font-size: 26rpx; color: var(--ecnu-dark-gray); }
.evidence-note { display: block; font-size: 24rpx; color: #888; line-height: 1.7; margin-top: 20rpx; }

.btn {
  width: 100%; 
  padding: 20rpx;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn--primary {
  background-color: var(--ecnu-primary);
  color: var(--ecnu-bg-white);
  box-shadow: 0 10rpx 20rpx rgba(var(--ecnu-primary-rgb), var(--alpha-25));
}

.btn--ghost {
  background-color: transparent;
  color: var(--ecnu-primary);
  border: 2rpx solid var(--ecnu-primary);
}

.btn--plain {
  /* “清除本地缓存”等次要操作按钮 */
  background-color: transparent;
  color: var(--ecnu-dark-gray);
  font-size: 28rpx;
  padding: 20rpx 0;
}
