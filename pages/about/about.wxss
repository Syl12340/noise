/* pages/about/about.wxss */
page {
  background: #F4F5F7;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page-container { padding: 40rpx 32rpx 60rpx; }

/* 头部 */
.doc-header { margin-bottom: 40rpx; padding: 0 10rpx; }
.title { font-size: 56rpx; font-weight: 800; color: #111; display: block; margin-bottom: 8rpx; }
.subtitle { font-size: 24rpx; font-weight: 600; color: #A41F35; letter-spacing: 2rpx; }

/* 文档卡片 */
.doc-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 32rpx;
}

.cover-pic {
  width: 100%;
  height: 320rpx;
  border-radius: 20rpx;
  margin-bottom: 40rpx;
  background-color: #FAFAFA; /* 图片加载前的底色 */
  border: 1rpx solid #F0F0F0;
}

/* 正文排版 */
.article { display: flex; flex-direction: column; }
.h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 24rpx;
  position: relative;
  padding-left: 20rpx;
}
/* 标题左侧的红色装饰线 */
.h2::before {
  content: ""; position: absolute; left: 0; top: 8rpx; bottom: 8rpx;
  width: 8rpx; background: #A41F35; border-radius: 4rpx;
}

.p {
  font-size: 30rpx;
  line-height: 1.8;
  color: #555555;
  margin-bottom: 30rpx;
  text-align: justify; /* 两端对齐更具文档感 */
}

/* 机构落款 */
.institution {
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #EAEAEA;
  display: flex;
  flex-direction: column;
}
.inst-name { font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 6rpx; }
.inst-dept { font-size: 24rpx; color: #888; }