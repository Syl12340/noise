<view class="page">
  <!-- 顶部导航 -->
  <view class="nav">
    <text class="nav__title">个人设置</text>
  </view>

  <scroll-view scroll-y class="content">
    <!-- 暴露目标 -->
    <view class="group">
      <view class="group__title">暴露目标</view>
      <view class="cell">
        <text class="cell__label">预期暴露时长</text>
        <view class="cell__right">
          <view
           class="stepper__btn {{duration <= 0 ? 'stepper__btn--disabled' : ''}}"
           bindtap="changeDuration"
           data-delta="-0.5"
           wx:if="{{duration > 0}}"
          >−</view>

          <view class="stepper__btn stepper__btn--disabled"
            wx:else
          >−</view>
          
          <text class="stepper__value">{{duration}} h</text>
          <view class="stepper__btn" data-delta="0.5" bindtap="changeDuration" >+</view>
        </view>
      </view>

      <view class="cell">
        <text class="cell__label">累计能量阈值</text>
        <slider class="slider" min="30" max="150" step="5" value="{{energy}}" bindchange="changeEnergy" activeColor="#A41F35"/>
        <text class="slider__value">{{energy}}</text>
      </view>

      <view class="cell">
        <text class="cell__label">能量单位</text>
        <picker value="{{unitIndex}}" range="{{units}}" range-key="name" bindchange="changeUnit">
          <view class="picker">{{units[unitIndex].name}}</view>
        </picker>
      </view>
    </view>

    <view class="group">
      <view class="group__title">风险阶段划分（CNE）</view>

      <view class="risk-card">
        <view class="risk-card__title">分段启用</view>
        <checkbox-group bindchange="onRiskEnabledChange">
          <view class="risk-enable-item">
            <view class="risk-enable-left">
              <checkbox checked="{{true}}" disabled="{{true}}" color="#A41F35" />
              <text class="risk-enable-text">启用“需要注意”分段（固定）</text>
            </view>
          </view>

          <view class="risk-enable-item">
            <view class="risk-enable-left">
              <checkbox value="medium" checked="{{riskConfig.enabled.medium}}" color="#A41F35" />
              <text class="risk-enable-text">启用“中风险”分段</text>
            </view>
          </view>

          <view class="risk-enable-item risk-enable-item--last">
            <view class="risk-enable-left">
              <checkbox value="high" checked="{{riskConfig.enabled.high}}" color="#A41F35" />
              <text class="risk-enable-text">启用“高风险”分段</text>
            </view>
          </view>
        </checkbox-group>
      </view>

      <view class="risk-card">
        <view class="risk-card__title">分段上限设置</view>

        <view class="risk-limit-item">
          <text class="risk-limit-label">安全上限</text>
          <view class="risk-limit-right">
            <input class="risk-limit-input risk-limit-input--fixed" type="digit" value="{{riskConfig.safeMax}}" disabled="{{true}}" />
            <text class="risk-limit-unit">dB(A)</text>
          </view>
        </view>

        <view class="risk-limit-item">
          <text class="risk-limit-label">需要注意上限</text>
          <view class="risk-limit-right">
            <input class="risk-limit-input" type="digit" data-key="attentionMax" value="{{riskConfig.limits.attentionMax}}" bindblur="onRiskLimitInput" />
            <text class="risk-limit-unit">dB(A)</text>
          </view>
        </view>

        <view class="risk-limit-item {{!riskConfig.enabled.medium ? 'risk-limit-item--disabled' : ''}}">
          <text class="risk-limit-label">中风险上限</text>
          <view class="risk-limit-right">
            <input class="risk-limit-input" type="digit" data-key="mediumMax" value="{{riskConfig.limits.mediumMax}}" bindblur="onRiskLimitInput" disabled="{{!riskConfig.enabled.medium}}" />
            <text class="risk-limit-unit">dB(A)</text>
          </view>
        </view>

        <view class="risk-limit-item risk-limit-item--last {{!riskConfig.enabled.high ? 'risk-limit-item--disabled' : ''}}">
          <text class="risk-limit-label">高风险上限</text>
          <view class="risk-limit-right">
            <input class="risk-limit-input" type="digit" data-key="highMax" value="{{riskConfig.limits.highMax}}" bindblur="onRiskLimitInput" disabled="{{!riskConfig.enabled.high}}" />
            <text class="risk-limit-unit">dB(A)</text>
          </view>
        </view>
      </view>

      <view class="risk-note">
        <text decode="{{true}}" class="risk-note__text">风险档位：≤安全上限、&lt;注意上限、&lt;中风险上限、&lt;高风险上限、≥高风险上限；“需要注意”分段为固定锚点，关闭中间分段后将自动并入更高风险档。</text>
      </view>
    </view>

    <!-- 提醒与权限 -->
    <view class="group">
      <view class="group__title">提醒与权限</view>
      <view class="cell">
        <text class="cell__label">超标提醒</text>
        <switch checked="{{alarm}}" bindchange="toggleAlarm" color="#A41F35"/>
      </view>
      <view class="btn btn--plain" bindtap="requestRecord">麦克风权限管理</view>
    </view>
    <!-- 麦克风参数 -->
    <view class="group">
      <view class="group__title">麦克风参数</view>
      
      <view class="cell">
        <text class="cell__label">偏移量</text>
        <slider class="slider" min="-200" max="200" step="1" value="{{offset}}" bindchange="changeOffset" activeColor="#A41F35"/>
        <text class="slider__value">{{offset}}</text>
      </view>
      <view class="group__subtitle">（慎重调整，直接影响测量结果）</view>
    </view>

    <!-- 外观设置 -->
    <view class="group">
      <view class="group__title">外观与缓存</view>
      <view class="cell">
        <text class="cell__label">深色模式（未适配）</text>
        <switch checked="{{darkMode}}" bindchange="toggleDark" color="#A41F35"/>
      </view>
    </view>


    <!-- 底部操作 -->
    <view class="footer">
      <button class="btn btn--primary" bindtap="save">保存</button>
      <button class="btn btn--ghost" bindtap="clearCache">清除缓存</button>
      <button class="btn btn--ghost" bindtap="reset">恢复默认</button>
    </view>
  </scroll-view>
</view>

