page {
  background-color: #F4F5F7;
  min-height: 100vh;
  font-family: -apple-system, sans-serif;
}

/* 去掉蓝色的渐变导航背景，改为原生大标题风格 */
.nav {
  padding: 60rpx 32rpx 20rpx;
  background: transparent;
  box-shadow: none;
}
.nav__title {
  font-size: 56rpx;
  font-weight: 800;
  color: #111111;
  letter-spacing: 2rpx;
}

.content {
  padding: 0 0 60rpx 0;
}

/* 列表容器 */
.group {
  margin: 20rpx 32rpx 50rpx;
  background-color: transparent;
  box-shadow: none;
  padding: 0;
}

/* 分组标题 */
.group__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #888888;
  padding: 0 0 16rpx 16rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}
.group__subtitle {
  font-size: 24rpx;
  color: #AAAAAA;
  padding: 16rpx 0 0 16rpx;
}

/* 为了实现 iOS 那种全包裹的白色卡片，这里假设你在 wxml 里给 cell 外面套了一个包裹层。
   如果没有套，直接作用在组上也可以，这里用直接相邻选择器给 Cell 加白底 */
.cell {
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

/* 第一项顶部圆角，最后一项底部圆角，实现卡片包裹效果 */
.cell:first-of-type {
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
}
.cell:last-of-type {
  border-bottom-left-radius: 24rpx;
  border-bottom-right-radius: 24rpx;
  border-bottom: none;
}

.cell__label {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
}
.cell__right {
  display: flex;
  align-items: center;
}

/* 步进器美化：更现代的无边框圆角按钮 */
.stepper__btn {
  width: 64rpx;
  height: 64rpx;
  background: #F4F5F7;
  border-radius: 50%;
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  line-height: 60rpx;
  color: var(--ecnu-primary);
  border: none;
  transition: all 0.2s;
}
.stepper__btn:active {
  background: #EAEAEA;
}
.stepper__btn--disabled {
  background: #F9F9F9;
  color: #CCCCCC;
}

.stepper__value {
  width: 110rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #111;
  font-variant-numeric: tabular-nums;
}

.slider {
  flex: 1;
  margin: 0 30rpx;
}
.slider__value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ecnu-primary);
  min-width: 60rpx;
  text-align: right;
}

.picker {
  padding: 12rpx 24rpx;
  background: #F4F5F7;
  color: #333;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* 按钮区美化：高级悬浮质感 */
.footer {
  padding: 20rpx 40rpx;
  display: flex;
  flex-direction: column; /* 竖向排列更符合移动端习惯 */
  gap: 30rpx;
}

.btn {
  width: 100% !important; /* 强制填满容器 */
  padding: 26rpx 0;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 100rpx; /* 大胶囊按钮 */
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn--primary {
  background: var(--ecnu-primary);
  color: #FFFFFF;
  box-shadow: 0 10rpx 20rpx rgba(var(--ecnu-primary-rgb), var(--alpha-25));
}

.btn--ghost {
  background: transparent;
  color: var(--ecnu-primary);
  border: 2rpx solid var(--ecnu-primary);
}

.btn--plain {
  /* “清除本地缓存”等次要操作按钮 */
  background: transparent;
  color: #888888;
  font-size: 28rpx;
  padding: 20rpx 0;
}

.risk-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 20rpx;
}

.risk-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #555;
  padding: 20rpx 26rpx 12rpx;
}

.risk-enable-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.risk-enable-item--last {
  border-bottom: none;
  padding-bottom: 20rpx;
}

.risk-enable-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.risk-enable-text {
  font-size: 30rpx;
  color: #3f3f3f;
}

.risk-limit-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-top: 1rpx solid #f6f6f6;
}

.risk-limit-item--last {
  padding-bottom: 22rpx;
}

.risk-limit-item--disabled {
  opacity: 0.45;
}

.risk-limit-label {
  font-size: 32rpx;
  color: #333;
}

.risk-limit-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.risk-limit-input {
  width: 170rpx;
  height: 64rpx;
  border-radius: 12rpx;
  border: 1rpx solid #ececec;
  background: #f8f8fa;
  text-align: center;
  font-size: 34rpx;
  color: #4d4d4d;
  font-variant-numeric: tabular-nums;
}

.risk-limit-input--fixed {
  color: #6a6a6a;
}

.risk-limit-unit {
  font-size: 24rpx;
  color: #8f8f8f;
}

.risk-note {
  padding: 6rpx 4rpx 0;
}

.risk-note__text {
  display: block;
  font-size: 24rpx;
  color: #8a8a8a;
  line-height: 1.6;
}