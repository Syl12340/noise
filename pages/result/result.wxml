<!-- pages/result/result.wxml -->
<view class="page">
  <!-- 顶部标题与操作 -->
  <view class="header-bar">
    <text class="page-title">监测记录</text>
    <text wx:if="{{!isEmpty}}" class="clear-btn" bindtap="confirmDeleteAll">清空全部</text>
  </view>

  <view class="grid">
    <view class="text-no-result" wx:if="{{isEmpty}}">
      <image class="empty-icon" src="/images/chart.svg" mode="aspectFit"></image>
      <text>暂无监测记录</text>
    </view>

    <!-- 记录卡片列表 -->
    <block wx:for="{{savedResult}}" wx:key="index">
      <view 
        class="card {{activeIndex === index ? 'card-active' : ''}}"
        hover-class="card-hover"
        data-index="{{index}}"
        bindtap="handleCardTap"
        bind:longpress="handleCardLongPress"
      >
        <!-- 动态风险色带（5级映射：安全/需要注意/中风险/高风险/高危） -->
        <view class="risk-bar {{item.threatColorClass}}" ></view>

        <view class="card-content">
          <!-- 核心信息区 (始终显示) -->
          <view class="card-header">
            <view class="header-left">
              <text class="card-title">{{item.name || '未命名记录'}}</text>
              <text class="card-date">{{item.date}}</text>
              <text class="card-date">{{item.qualityLabel}}</text>
            </view>
            <view class="header-right">
              <text class="cne-val {{item.threatTextClass}}">{{item.cneDisplay}}</text>
              <text class="cne-unit">dB(A)，预计暴露</text>
            </view>
          </view>

          <!-- 详细信息区 (折叠手风琴) -->
          <view class="detail-wrapper">
            <view class="detail-grid">
              <view class="detail-item detail-full"><text class="detail-value">{{item.comparisonNote}}</text></view>
              <view class="detail-item detail-full"><text class="detail-value">{{item.qualityReason || '未记录额外质量原因'}}</text></view>
              <view class="detail-item">
                <text class="detail-label">预期暴露</text>
                <text class="detail-value">{{item.exposure}} s</text>
              </view>
              <view class="detail-item">
                <text class="detail-label">记录时长</text>
                <text class="detail-value">{{item.duration}} s</text>
              </view>
              <view class="detail-item">
                <text class="detail-label">风险评估</text>
                <text class="detail-value">{{item.threatDisplay}}</text>
              </view>
              <view class="detail-item">
                <text class="detail-label">偏移量</text>
                <text class="detail-value">{{item.offset}} dB</text>
              </view>
              <view class="detail-item detail-full">
                <text class="detail-label">经纬度 (gcj02)</text>
                <text class="detail-value">{{item.location ? item.location.latitude + ', ' + item.location.longitude : '未授权位置'}}</text>
              </view>
              <view class="detail-item detail-full">
                <text class="detail-label">采集设备</text>
                <text class="detail-value">{{item.device}} ({{item.system}})</text>
              </view>
              <view class="detail-item detail-full">
                <text class="detail-label">风险预警规则</text>
                <view class="risk-rule-list">
                  <text
                    wx:for="{{item.riskSegmentSummary}}"
                    wx:for-item="line"
                    wx:key="index"
                    class="risk-rule-line"
                  >{{line}}</text>
                </view>
              </view>
            </view>
            <view class="tip-text">长按卡片可重命名或删除此记录</view>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
