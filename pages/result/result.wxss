page {
  background: #F4F5F7;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.page { padding: 0 32rpx 40rpx; }

/* 头部 */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 40rpx 10rpx 30rpx;
}
.page-title { font-size: 48rpx; font-weight: 800; color: #111; }
.clear-btn { font-size: 28rpx; font-weight: 600; color: var(--ecnu-primary); padding: 10rpx 0; }

.grid { display: flex; flex-direction: column; gap: 24rpx; }

/* 空状态 */
.text-no-result { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; color: #999; font-size: 28rpx; }
.empty-icon { width: 120rpx; height: 120rpx; opacity: 0.3; margin-bottom: 20rpx; }

/* 卡片基础样式 */
.card {
  position: relative;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}
.card-hover { transform: scale(0.98); background: #FAFAFA; }

/* 左侧风险色带 */
.risk-bar { position: absolute; left: 0; top: 0; bottom: 0; width: 12rpx; transition: background 0.3s; }
.bg-safe { background: var(--ecnu-light-blue); }
.bg-attention { background: var(--ecnu-warn); }
.bg-medium { background: rgba(var(--ecnu-warn-rgb), 0.85); }
.bg-high { background: var(--ecnu-primary); }
.bg-extreme { background: #7e1729; }

/* 卡片内容区 */
.card-content { padding: 32rpx 32rpx 32rpx 44rpx; }

.card-header { display: flex; justify-content: space-between; align-items: center; }
.header-left { display: flex; flex-direction: column; gap: 8rpx; flex: 1; }
.card-title { font-size: 32rpx; font-weight: 700; color: #1A1A1A; }
.card-date { font-size: 24rpx; color: #888; }

.header-right { text-align: right; }
.cne-val { font-size: 48rpx; font-weight: 800; font-variant-numeric: tabular-nums; }
.cne-unit { font-size: 20rpx; color: #888; margin-left: 4rpx; font-weight: bold; }

/* 数值颜色绑定 */
.text-safe { color: var(--ecnu-light-blue); }
.text-attention { color: var(--ecnu-warn); }
.text-medium { color: rgba(var(--ecnu-warn-rgb), 0.95); }
.text-high { color: var(--ecnu-primary); }
.text-extreme { color: #7e1729; }

/* 手风琴详情区 */
.detail-wrapper {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: all 0.4s ease;
}
.card-active .detail-wrapper {
  max-height: 600rpx; /* 足够容纳内容的高度 */
  opacity: 1;
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx dashed #EAEAEA;
}

/* 详情网格布局 */
.detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.detail-item { display: flex; flex-direction: column; gap: 6rpx; }
.detail-full { grid-column: span 2; }
.detail-label { font-size: 22rpx; color: #999; text-transform: uppercase; }
.detail-value { font-size: 26rpx; font-weight: 500; color: #333; }

.tip-text { font-size: 22rpx; color: #CCC; text-align: center; margin-top: 30rpx; }