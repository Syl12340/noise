<!-- pages/main/main.wxml -->
<view class="page-container">
  <!-- 当前短时 Z 声级，不使用预计暴露风险配色 -->
  <view class="card dashboard">
    <view class="recording-tag">
      <view class="dot" wx:if="{{recordingState === 'recording'}}"></view>
      <text class="tag-text">{{recordingLabel}}</text>
    </view>
    
    <view class="main-value">
      <text class="db-num">{{dbspl}}</text>
      <text class="db-unit">dB SPL（当前短时 Z 计权）</text>
    </view>

  </view>

  <view class="card">
    <text>{{calibrationLabel}} · 校准日期 {{calibrationDate}}</text>
    <view><text>本次有效采样 {{measurementSeconds}} 秒 · 预计暴露 {{exposureHours}} 小时</text></view>
    <view><text>本次 LAeq：{{leqA}} dB(A)</text></view>
    <view><text>换算结果假设预计暴露期间声级与本次测量相同。</text></view>
  </view>

  <!-- 辅助数据两列 -->
  <view class="stats-row">
    <view class="card stats-card">
      <text class="stats-label">预计暴露级（归一至 8 小时）</text>
      <view class="stats-value">
        <text class="val">{{cne}}</text>
        <text class="unit">dB(A)</text>
      </view>
      <view class="status-pill {{threatClass}}">
        <text class="status-text">{{threat}}</text>
      </view>
    </view>
    <view class="card stats-card">
      <text class="stats-label">满刻度幅度 (dB FS)</text>
      <view class="stats-value">
        <text class="val">{{dbfs}}</text>
        <text class="unit">dB FS</text>
      </view>
    </view>
  </view>

  <!-- 可视化卡片（波形/频谱/频谱图切换） -->
  <view class="card chart-card">
    <view class="chart-header">
      <text class="chart-title">
        {{viewMode === 'waveform' ? '每秒声级 [Z计权，无风险配色]' :
          viewMode === 'spectrum' ? '频谱柱图 [1/3倍频程]' :
          '时频热力图 [时间-频率]' }}
      </text>
    </view>

    <!-- 视图切换标签 -->
    <view class="view-tabs">
      <view class="view-tab {{viewMode === 'waveform' ? 'view-tab-active' : ''}}"
            data-mode="waveform" bindtap="switchView">
        <text>声级走势</text>
      </view>
      <view class="view-tab {{viewMode === 'spectrum' ? 'view-tab-active' : ''}}"
            data-mode="spectrum" bindtap="switchView">
        <text>频谱柱图</text>
      </view>
      <view class="view-tab {{viewMode === 'spectrogram' ? 'view-tab-active' : ''}}"
            data-mode="spectrogram" bindtap="switchView">
        <text>时频热力图</text>
      </view>
    </view>

    <view class="canvas-container">
      <!-- 三个 Canvas 同时存在，CSS 控制可见性 -->
      <canvas id="canvas-front" type="2d" class="canvas-layer"
              style="display:{{viewMode === 'waveform' ? 'block' : 'none'}}" />
      <canvas id="canvas-spectrum" type="2d" class="canvas-layer"
              style="display:{{viewMode === 'spectrum' ? 'block' : 'none'}}" />
      <canvas id="canvas-spectrogram" type="2d" class="canvas-layer"
              style="display:{{viewMode === 'spectrogram' ? 'block' : 'none'}}" />
    </view>
  </view>

  <!-- 底部固定操作栏（按钮比例调整） -->
  <view class="action-bar">
  <!-- 缩小为正方形图标按钮 -->
  <view class="btn-mini" bindtap="recordMyLocation" hover-class="btn-hover-mini">
    <image src="/images/locate.svg" mode="aspectFit" class="mini-icon" />
  </view>

  <!-- 占据主要空间的两个平分按钮 -->
   <button class="btn-main btn-save" bindtap="_saveResult" disabled="{{!canSave}}">保存记录</button>
   <button wx:if="{{recordingState === 'recording' || recordingState === 'starting'}}" class="btn-main btn-stop" bindtap="stopNoiseMonitoring">停止并查看</button>
   <button wx:else class="btn-main" bindtap="restartMeasurement">重新测量</button>
   <button wx:if="{{recordingState === 'invalid' || recordingState === 'stopped'}}" class="btn-mini" bindtap="leaveMeasurement">退出</button>
  </view>
</view>
