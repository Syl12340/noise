/* pages/main/main.wxss */
.capture-note-input { margin-top: 20rpx; padding: 14rpx 18rpx; background: #F4F5F7; border-radius: 14rpx; font-size: 24rpx; color: var(--ecnu-dark-gray); }
page {
  background: #F4F5F7;
  font-family: -apple-system, sans-serif;
}

.page-container {
  padding: 30rpx 30rpx 220rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 基础卡片样式 */
.measurement-summary { padding: 28rpx; }
.summary-header { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; }
.calibration-badge { padding: 8rpx 16rpx; border-radius: 12rpx; background: rgba(var(--ecnu-primary-rgb), var(--alpha-10)); color: var(--ecnu-primary); font-size: 22rpx; line-height: 1.5; }
.summary-date { color: #888; font-size: 21rpx; line-height: 1.5; }
.summary-metrics { display: flex; flex-wrap: wrap; gap: 20rpx; margin-top: 24rpx; }
.summary-metric { flex: 1; min-width: 150rpx; display: flex; flex-direction: column; gap: 8rpx; }
.summary-caption { color: #888; font-size: 22rpx; }
.summary-number { color: #111; font-size: 32rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.summary-unit { color: #666; font-size: 20rpx; font-weight: 400; }
.summary-preview { margin-top: 22rpx; padding: 12rpx 16rpx; border-radius: 12rpx; background: #F4F5F7; color: var(--ecnu-dark-gray); font-size: 22rpx; line-height: 1.6; }
.summary-note { margin-top: 16rpx; color: #888; font-size: 21rpx; line-height: 1.6; }
.stats-card .status-pill { max-width: 100%; box-sizing: border-box; padding: 10rpx 18rpx; border-radius: 16rpx; text-align: center; }
.stats-card .status-text { font-size: 24rpx; line-height: 1.6; overflow-wrap: break-word; }
.action-bar .btn-main[disabled] { background: #E9EAEC; color: #999; border-color: #E9EAEC; box-shadow: none; }

.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.03);
  box-sizing: border-box;
}

/* --- 分贝区整块变色样式 --- */
.dashboard {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 40rpx;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1rpx solid rgba(0,0,0,0.05);
}

.detail-init {
  background: #FFFFFF;
}

/* 状态颜色：安全 */
.detail-safe {
  background-color: var(--bg-safe) !important;
}
.detail-safe .status-pill { background: var(--bg-safe); }
.detail-safe .status-text { color: var(--ecnu-dark); }

/* 状态颜色：测量数据无效 */
.detail-invalid {
  background-color: var(--bg-warn) !important;
}
.detail-invalid .status-pill { background: var(--bg-warn); }
.detail-invalid .status-text { color: var(--ecnu-dark); }

/* 状态颜色：需要注意 */
.detail-attention {
  background-color: var(--bg-warn) !important;
}
.detail-attention .status-pill { background: var(--bg-warn); }
.detail-attention .status-text { color: var(--ecnu-dark); }

/* 状态颜色：中风险 */
.detail-medium {
  background-color: var(--bg-medium) !important;
}
.detail-medium .status-pill { background: var(--bg-medium); }
.detail-medium .status-text { color: var(--ecnu-dark); }

/* 状态颜色：高风险 */
.detail-high {
  background-color: var(--bg-high) !important;
}
.detail-high .db-num, 
.detail-high .db-unit, 
.detail-high .tag-text,
.detail-high .stats-label { color: #FFFFFF !important; }
.detail-high .status-pill { background: var(--bg-high-soft); }
.detail-high .status-text { color: #FFFFFF !important; }
.detail-high .dot { background: #FFFFFF !important; box-shadow: none; }

.detail-extreme {
  background-color: var(--bg-extreme) !important;
  color: #FFFFFF !important;
}
.detail-extreme .db-num,
.detail-extreme .db-unit,
.detail-extreme .tag-text,
.detail-extreme .stats-label { color: #FFFFFF !important; }
.detail-extreme .status-pill { background: var(--bg-extreme-soft); }
.detail-extreme .status-text { color: #FFFFFF; }
.detail-extreme .dot { background: #FFFFFF !important; box-shadow: 0 0 15rpx #fff; }

.recording-tag { display: flex; align-items: center; gap: 12rpx; margin-bottom: 20rpx; }
.tag-text { font-size: 22rpx; color: #888; font-weight: bold; letter-spacing: 2rpx; }
.dot { width: 12rpx; height: 12rpx; background: var(--ecnu-primary); border-radius: 50%; animation: pulse 1.5s infinite; }

.main-value { display: flex; align-items: baseline; }
.db-num { font-size: 110rpx; font-weight: 800; color: #111; font-variant-numeric: tabular-nums; }
.db-unit { font-size: 32rpx; color: #666; font-weight: 600; margin-left: 10rpx; }

.status-pill { padding: 8rpx 36rpx; border-radius: 100rpx; margin-top: 20rpx; }
.status-text { font-size: 28rpx; font-weight: bold; }

/* 辅助数据行 */
.stats-row { display: flex; gap: 24rpx; }
.stats-card { flex: 1; padding: 30rpx; }
.stats-label { font-size: 22rpx; color: #999; display: block; margin-bottom: 12rpx; }
.stats-value { display: flex; align-items: baseline; }
.stats-value .val { font-size: 44rpx; font-weight: 700; color: #333; font-variant-numeric: tabular-nums; }
.stats-value .unit { font-size: 20rpx; color: #AAA; margin-left: 6rpx; }

/* --- 图表居中控制 --- */
.chart-card { padding-bottom: 30rpx; }
.chart-header { padding: 30rpx 40rpx 0; }
.chart-title { font-size: 24rpx; color: #90a4ae; font-weight: 600; }

/* 视图切换标签 */
.view-tabs {
  display: flex;
  flex-direction: row;
  padding: 16rpx 40rpx 20rpx;
  gap: 16rpx;
}

.view-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #90a4ae;
  background: #F4F5F7;
  transition: all 0.25s ease;
}

.view-tab-active {
  color: #FFFFFF;
  background: var(--ecnu-primary);
  box-shadow: 0 4rpx 12rpx rgba(var(--ecnu-primary-rgb), 0.3);
}

.canvas-container {
  width: 100%;
  height: 780rpx;
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;         /* 开启 flex */
  justify-content: center; /* 水平居中 */
  align-items: center;     /* 垂直居中 */
  background: #fff;
  position: relative;
  overflow: visible;
}
/* canvas-layer 不再使用 absolute 以配合 flex 居中，或者手动指定 canvas 大小 */
.canvas-layer {
  width: 640rpx;  /* 为底部安全边距预留更充足的显示空间 */
  height: 640rpx;
}

/* --- 底部操作栏 --- */
.action-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20px);
  padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 20rpx; /* 元素间距 */
  box-shadow: 0 -4rpx 30rpx rgba(0,0,0,0.05);
  z-index: 100;
}

/* 小巧正方形位置按钮 */
.btn-mini {
  width: 100rpx;
  height: 100rpx;
  background: #F4F5F7;
  border-radius: 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0; /* 防止被右侧按钮挤压变形 */
}

.mini-icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.7;
}

.btn-hover-mini {
  background: #EAECEF;
}

.btn-main {
  flex: 1; /* 平分剩余宽度 */
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 30rpx;
  font-weight: bold;
  margin: 0 !important; /* 覆盖微信原生button组件默认margin */
  padding: 0;
}

.btn-save {
  background: var(--ecnu-primary);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(var(--ecnu-primary-rgb), var(--alpha-25));
}

.btn-stop {
  background: #FFFFFF;
  color: var(--ecnu-primary);
  border: 3rpx solid var(--ecnu-primary);
}
@keyframes pulse {
  0% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.8); }
  100% { opacity: 1; transform: scale(1); }
}
