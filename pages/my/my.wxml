<!-- pages/my/my.wxml -->
<view class="page-container">
  <!-- 顶部名片区 -->
  <view class="profile-header">
    <view class="avatar-wrapper" bindtap="login">
      <image class="avatar" src="{{userInfo.avatarUrl || 'https://mmbiz.qpic.cn/mmbiz/icTdbqWNOwNRna42FI242Lcia07jQodd2FJGIYQfG0LAJGFxM4FbnQP6yfMxBgJ0F3YRqJCJ1aPAK2dQagdusBZg/0'}}" mode="aspectFill" />
      <!-- 身份徽章 -->
      <view class="badge" wx:if="{{isLoggedIn && userInfo.groupType}}">{{userInfo.groupType}}</view>
    </view>
    <view class="info-wrapper" bindtap="login">
      <text class="nickname">{{userInfo.nickname || '未登录'}}</text>
      <text class="uid" wx:if="{{isLoggedIn}}">UID: {{userInfo.userId}}</text>
    </view>
  </view>

  <!-- 功能卡片列表 -->
  <view class="menu-group">
    <view class="menu-item" bindtap="goToUserProfile">
      <text class="menu-text">个人档案</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToSettings">
      <text class="menu-text">监测参数设置</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录按钮 -->
  <view wx:if="{{isLoggedIn}}" class="logout-card" hover-class="btn-hover" bindtap="logout">
    <text>退出登录</text>
  </view>

  <!-- 底部版权信息 -->
  <view class="footer">
    <text>噪声累积能量监测 小程序</text>
    <text class="footer-sub">华东师范大学教育学部国创项目</text> 
    <text class="footer-sub">{{version}}</text>
    <text class="footer-sub">预览版本</text>
    <text class="footer-sub">\n\n测量数据仅供参考</text>
    <text class="footer-sub">如需高精度检测，请使用专业声级计</text>
    
  </view>
</view>