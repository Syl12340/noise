<!-- pages/pilot/pilot.wxml -->
<view class="page">
  <view class="e"></view>
  <view class="grid">
    <!-- 如何监测 -->
    <view class="card" hover-class="card--pressed" bindtap="goToUsage">
      <image class="card__icon" src="/images/info.svg" />
      <view class="card__body">
        <text class="card__title">如何监测</text>
        <text class="card__desc">关于监测的重点事项</text>
      </view>
    </view>

    <!-- 麦克风校准 -->
    <view class="card" hover-class="card--pressed" bindtap="goToCalibrate">
      <image class="card__icon" src="/images/calibrate.svg" />
      <view class="card__body">
        <text class="card__title">麦克风校准</text>
        <text class="card__desc">声压级校正 · 偏移量测定</text>
      </view>
    </view>

    <!-- 开始监测 (核心功能) -->
    <view class="card" hover-class="card--pressed" bindtap="noiseDetect">
      <image class="card__icon" src="/images/mic.svg" />
      <view class="card__body">
        <text class="card__title">开始监测</text>
        <text class="card__desc">实时监测 · 5秒出结果</text>
      </view>
    </view>

     <!-- 高级校准 -->
    <view class="card" hover-class="card--pressed" bindtap="goToAdvancedCalibrate">
      <image class="card__icon" src="/images/calibrate.svg" />
      <view class="card__body">
        <text class="card__title">高级校准选项（实验性）</text>
        <text class="card__desc">实验性功能与云端预设</text>
      </view>
    </view> 
  </view>
  <view class="tips">
    <text>建议在实验室环境下完成校准流程</text>
  </view>
</view>