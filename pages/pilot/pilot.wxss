/* pages/pilot/pilot.wxss */

page {
  background: #f5f7fa; /* 与 Index 一致的浅灰底色 */
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.page {
  padding: 40rpx;
}

.grid {
  display: flex;
  flex-direction: column;
  gap: 80rpx; /* 卡片间距 */
}

.card {
  display: flex;
  align-items: center;
  padding: 36rpx 40rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: background 0.2s;
}

/* 交互反馈：按下的瞬间背景变色 */
.card--pressed {
  background: rgba(164, 31, 53, 0.05) !important; /* 这里使用了华师大红的极浅透明色 */
}
.card--pressed {
  background: #FAFAFA !important;
  transform: scale(0.97);
  box-shadow: 0 2rpx 10rpx rgba(164, 31, 53, 0.05);
}

.card__icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 32rpx;
  flex-shrink: 0;
}

.card__body {
  flex: 1;
}

.card__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
}

.card__desc {
  font-size: 26rpx;
  color: #888;
  margin-top: 8rpx;
  display: block;
}

/* 右侧箭头小图标 */
.card__arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.2;
}

.tips {
  margin-top: 80rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}
.e {
  margin-top: 125px;
}